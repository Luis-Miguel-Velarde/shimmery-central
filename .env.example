# Run setup-postgres.cmd to create the project database and private .env.
# The app reads private connection settings from .env on startup.
DB_ENGINE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=shimmery_central
PGUSER=shimmery_app
PGPASSWORD=replace-with-the-project-account-password

# For Render hosting, set these in its dashboard (see HOSTING.md).
# NODE_ENV=production
# HOST=0.0.0.0
# DATABASE_URL=your-private-Neon-connection-string
# SEED_PIN=your-private-8-to-12-digit-PIN
